---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { experience } from "../data/experience.js";
---
<Layout title="Career — Breno Almeida">
<div class="wrap">
<Header />
<section class="hero"><div class="kicker">Career · Experience</div><h1>A career<br/><span>in motion.</span></h1><p>Project management, game production, operations and design across games, digital products, events and creative businesses.</p></section>
<section class="timeline">
{experience.map(e=><article class="event"><div class="date">{e.period}</div><div class="body">{e.logo && <img src={`/Resume/assets/experience/${encodeURIComponent(e.logo)}`} alt="" />}<div><h2>{e.company}</h2><h3>{e.role}</h3><p>{e.summary}</p></div></div></article>)}
</section>
</div>
<style>
:global(body){margin:0;background:#f7f7f4;color:#111214;font-family:Inter,system-ui,sans-serif}.wrap{max-width:1160px;margin:auto;padding:0 28px}.hero{padding:90px 0 80px;border-bottom:1px solid #dedfdd}.kicker{font-size:11px;text-transform:uppercase;letter-spacing:.17em;color:#74777d}.hero h1{font-size:clamp(60px,9vw,120px);line-height:.83;letter-spacing:-.09em;margin:25px 0}.hero h1 span{color:transparent;-webkit-text-stroke:1.5px #111214}.hero p{max-width:650px;color:#62656b;font-size:18px;line-height:1.5}.timeline{padding:70px 0}.event{display:grid;grid-template-columns:170px 1fr;border-bottom:1px solid #dedfdd;padding:34px 0}.date{font-size:11px;color:#74777d;text-transform:uppercase;letter-spacing:.1em}.body{display:grid;grid-template-columns:72px 1fr;gap:24px}.body img{width:72px;height:72px;object-fit:contain;border:1px solid #dedfdd;background:#fff;padding:9px}.body h2{font-size:26px;letter-spacing:-.05em;margin:0}.body h3{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#74777d;margin:7px 0 15px}.body p{max-width:680px;color:#62656b;line-height:1.6;font-size:14px;margin:0}@media(max-width:700px){.event{grid-template-columns:1fr;gap:15px}.body{grid-template-columns:52px 1fr;gap:15px}.body img{width:52px;height:52px}}
</style>
