---
import Layout from "../layouts/Layout.astro";
import { projects, gameProjects } from "../data/projects.js";
import { experience } from "../data/experience.js";

const artwork = {
  "The Division Resurgence":"The Division Resurgence.png",
  "Hearts of Iron IV: Trial of Allegiance":"Heats of Iron IV Trial of Allegiance.png",
  "Cobra Kai: The Karate Kid Saga Continues":"Cobra Kai The Karate Kid Saga Continues.png",
  "Age of Rivals: Conquest":"Age of Rivals Conquest.png",
  "So Fart Away":"So Fart Away.png"
};
---

<Layout>
<main>
  <section class="home" id="home">
    <div class="particles" aria-hidden="true">
      {Array.from({length:14}).map((_,i)=><span class="particle" style={`--i:${i}`}></span>)}
    </div>
    <div class="name" id="name">
      <div class="title-wrap">
        <span class="boa-initial" aria-hidden="true">BOA</span>
        <h1 class="full-name"><span>B</span>reno <span>d</span>e <span>O</span>liveira <span>A</span>lmeida</h1>
      </div>
      <p>PROJECT MANAGER · GAME PRODUCER · GAME DESIGNER</p>
    </div>
    <div class="orbit" id="orbit" aria-label="Career navigation">
      <div class="float about"><button class="bubble" data-section="about">About</button></div>
      <div class="float experience"><button class="bubble" data-section="experience">Experience</button></div>
      <div class="float projects"><button class="bubble" data-section="projects">Projects</button></div>
      <div class="float games"><button class="bubble" data-section="games">Games</button></div>
      <div class="float skills"><button class="bubble" data-section="skills">Capabilities</button></div>
      <div class="float contact"><button class="bubble" data-section="contact">Contact</button></div>
    </div>
    <div class="home-meta">SÃO PAULO · BRAZIL <span>10+ YEARS</span></div>
    <div class="home-hint">CLICK A BUBBLE TO EXPLORE</div>
  </section>

  <div class="scrollbar"><button class="mini" id="mini">BOA</button></div>

  <div class="content">
    <section class="section collapsed" id="section-about">
      <div class="section-head"><div class="page-icon">◎</div><div><p class="kicker">01 · About</p><h2>About</h2></div></div>
      <div class="about-layout">
        <div class="about-story">
          <p class="lead">I turn complex ideas into clear, shippable experiences.</p>
          <p>I'm Breno — Project Manager, Game Producer and Game Designer working across technology, games and creative products.</p>
          <p>I like being where strategy meets execution: turning ambiguity into plans, connecting people and disciplines, and keeping teams moving toward something real.</p>
          <p>My background spans game development, production, consulting, events and creative education.</p>
        </div>
        <div class="focus">
          <div><b>01</b><strong>Structure</strong><span>Turn complexity into a workable path.</span></div>
          <div><b>02</b><strong>People</strong><span>Align teams around shared outcomes.</span></div>
          <div><b>03</b><strong>Delivery</strong><span>Move ideas from concept to shipped.</span></div>
        </div>
      </div>
    </section>

    <section class="section collapsed" id="section-experience">
      <div class="section-head"><div class="page-icon">◫</div><div><p class="kicker">02 · Career</p><h2>Experience</h2></div></div>
      <p class="intro">More than a decade across games, production, consulting, events and project management.</p>
      <div class="timeline">
        {experience.map(e => <article class="role">
          <div class="role-date">{e.period}</div>
          <div class="role-main">
            {e.logo && <div class="role-logo"><img src={`${import.meta.env.BASE_URL}assets/${e.logoFolder || "experience"}/${encodeURIComponent(e.logo)}`} alt="" /></div>}
            <div><h3>{e.role}</h3><div class="company">{e.company}</div><p>{e.summary}</p></div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="section collapsed" id="section-projects">
      <div class="section-head"><div class="page-icon">⌘</div><div><p class="kicker">03 · Selected Work</p><h2>Projects</h2></div></div>
      <p class="intro">Selected work across independent games, AAA-related production, licensed IP and client delivery.</p>
      <div class="project-list">
        {projects.map(p => <article class="project">
          <div class="project-art">{artwork[p.title] && <img src={`${import.meta.env.BASE_URL}assets/projects/${encodeURIComponent(artwork[p.title])}`} alt="" />}</div>
          <div><div class="meta">{p.client}</div><h3>{p.title}</h3><div class="role-label">{p.role}</div><p>{p.description}</p></div>
        </article>)}
      </div>
    </section>

    <section class="section collapsed" id="section-games">
      <div class="section-head"><div class="page-icon">◉</div><div><p class="kicker">04 · Archive</p><h2>Games</h2></div></div>
      <p class="intro">An archive of {gameProjects.length}+ games and interactive projects across production, design and collaboration.</p>
      <div class="game-grid">{gameProjects.slice(0,24).map(g => <span>{g}</span>)}</div>
      <a class="archive-link" href={`${import.meta.env.BASE_URL}games/`}>OPEN FULL GAMES ARCHIVE ↗</a>
    </section>

    <section class="section collapsed" id="section-skills">
      <div class="section-head"><div class="page-icon">✦</div><div><p class="kicker">05 · Toolkit</p><h2>Capabilities</h2></div></div>
      <div class="skill-grid">
        <article><h3>Project Management</h3><p>Agile · Scrum · Kanban · PMO · Roadmaps · Scope · Risk · Stakeholder Management · Planning · Delivery</p></article>
        <article><h3>Strategy & Operations</h3><p>Discovery · Strategic Planning · OKRs · Process Design · Business Development · Partnerships · Creative Operations</p></article>
        <article><h3>Games</h3><p>Game Design · Game Production · Systems Design · UGC · Prototyping · Publishing · Live Operations</p></article>
        <article><h3>Tools</h3><p>ClickUp · Jira · Trello · Confluence · Notion · Monday · Miro · Figma · Google Workspace</p></article>
        <article><h3>Engines & Creation</h3><p>Unreal Engine · Unity · UEFN · Godot · Roblox Studio · GameMaker · Construct · Blender · Aseprite · Photoshop</p></article>
        <article><h3>Languages</h3><p>Portuguese — native · English — fluent · French — strong reading · Spanish — comprehension</p></article>
      </div>
    </section>

    <section class="section collapsed" id="section-contact">
      <div class="section-head"><div class="page-icon">✉</div><div><p class="kicker">06 · Contact</p><h2>Contact</h2></div></div>
      <div class="contact-layout"><div><p class="lead">Let's build something worth shipping.</p><p class="intro">Available for project management, game production, creative operations, consulting and selected collaborations.</p></div>
      <div class="contact-details"><div><span>Location</span><strong>São Paulo, Brazil</strong></div><div><span>Role focus</span><strong>Project Management / Game Production</strong></div><div><span>Studio</span><strong>TheBOA.Games</strong></div><div><span>Brand</span><strong>BOA.Productions</strong></div></div></div>
    </section>
  </div>
</main>

<style>
:global(:root){--bg:#06100c;--text:#f2f8f4;--muted:#9aada4;--mint:#a9f5c8;--line:rgba(169,245,200,.18)}
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif;overflow-x:hidden}:global(button){font:inherit}
.home{position:relative;width:100%;height:100svh;min-height:620px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 50%,rgba(169,245,200,.065),transparent 38%),var(--bg)}
.particles{position:absolute;inset:0;overflow:hidden;pointer-events:none}.particle{position:absolute;left:calc(4% + var(--i)*7.1%);bottom:-8vh;width:clamp(8px,1vw,18px);aspect-ratio:1;border:1px solid rgba(169,245,200,.22);border-radius:50%;background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.16),rgba(169,245,200,.04) 45%,transparent 70%);filter:blur(2px);animation:rise calc(14s + var(--i)*.8s) linear calc(var(--i)*-1.2s) infinite}
@keyframes rise{from{transform:translate3d(0,10vh,0) scale(.7);opacity:0}12%{opacity:.55}75%{opacity:.25}to{transform:translate3d(calc((var(--i) - 7)*12px),-120vh,0) scale(1.3);opacity:0}}
.name{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:5;text-align:center;pointer-events:none;width:96vw}.title-wrap{position:relative;display:grid;place-items:center}.boa-initial,.full-name{grid-area:1/1;white-space:nowrap}.boa-initial{font-size:clamp(3rem,8vw,7rem);letter-spacing:-.08em;color:var(--mint);transition:.75s cubic-bezier(.16,1.25,.3,1)}.full-name{margin:0;font-size:clamp(2rem,5.2vw,7rem);line-height:1;letter-spacing:-.065em;font-weight:500;opacity:0;transform:scale(.18);transition:opacity .7s ease,transform .9s cubic-bezier(.16,1.25,.3,1)}.full-name span{color:var(--mint)}.name.expanded .boa-initial{opacity:0;transform:scale(.15)}.name.expanded .full-name{opacity:1;transform:scale(1)}.name p{margin:22px 0 0;color:var(--muted);font-size:11px;letter-spacing:.18em}.orbit{position:absolute;inset:0;z-index:10;pointer-events:none}.float{position:absolute;width:clamp(92px,10vw,126px);aspect-ratio:1;pointer-events:auto;animation:float 5.5s ease-in-out infinite}.float.about{left:8%;top:15%}.float.experience{right:8%;top:16%;animation-delay:-1.1s}.float.projects{left:9%;bottom:14%;animation-delay:-2.1s}.float.games{right:9%;bottom:15%;animation-delay:-3.1s}.float.skills{left:50%;top:7%;margin-left:calc(clamp(92px,10vw,126px)/-2);animation-delay:-1.7s}.float.contact{right:38%;bottom:7%;animation-delay:-2.7s}
@keyframes float{50%{transform:translateY(-9px)}}
.bubble{width:100%;height:100%;border:1px solid rgba(169,245,200,.65);border-radius:50%;background:rgba(8,23,16,.72);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);color:var(--mint);display:flex;align-items:center;justify-content:center;text-align:center;font-size:clamp(.62rem,1vw,.78rem);font-weight:500;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;touch-action:none;user-select:none;transition:transform .25s ease,background .25s ease,border-color .25s ease,box-shadow .25s ease}.bubble:hover,.bubble:focus-visible{background:rgba(169,245,200,.1);border-color:var(--mint);box-shadow:0 0 35px rgba(169,245,200,.15);outline:none}.bubble.dragging{transform:translate3d(var(--dx,0),var(--dy,0),0) scale(1.12);transition:none}.float.dragging{animation:none;z-index:50}.float.returning .bubble{animation:snap .82s cubic-bezier(.16,1.25,.3,1) forwards!important}@keyframes snap{0%{transform:translate3d(var(--return-x),var(--return-y),0) scale(1.12)}42%{transform:translate3d(calc(var(--return-x)*-.1),calc(var(--return-y)*-.1),0) scale(1.07)}68%{transform:translate3d(calc(var(--return-x)*.025),calc(var(--return-y)*.025),0) scale(.97)}100%{transform:translate3d(0,0,0) scale(1)}}
.home-meta,.home-hint{position:absolute;bottom:24px;color:var(--muted);font-size:9px;letter-spacing:.14em}.home-meta{left:24px}.home-meta span{margin-left:22px;color:var(--mint)}.home-hint{right:24px}.scrollbar{position:fixed;top:0;left:0;right:0;height:74px;z-index:100;pointer-events:none}.mini{position:absolute;top:15px;left:50%;transform:translateX(-50%) scale(.8);width:52px;height:52px;border:1px solid rgba(169,245,200,.65);border-radius:50%;background:rgba(8,23,16,.88);color:var(--mint);cursor:pointer;pointer-events:auto;opacity:0;visibility:hidden;transition:.35s;backdrop-filter:blur(12px)}.mini.visible{opacity:1;visibility:visible;transform:translateX(-50%) scale(1)}
.content{width:100%;max-width:1000px;margin:0 auto;padding:0 24px}.section{min-height:100vh;padding:110px 0 80px}.collapsed{display:none}.section-head{display:flex;align-items:end;gap:20px;margin-bottom:42px}.page-icon{width:58px;height:58px;display:grid;place-items:center;border:1px solid rgba(169,245,200,.28);border-radius:18px;background:rgba(169,245,200,.035);color:var(--mint);font-size:24px}.kicker,.meta{margin:0 0 8px;color:var(--mint);font-size:.7rem;letter-spacing:.15em;text-transform:uppercase}.section h2{margin:0;font-size:clamp(2.7rem,7vw,5.8rem);line-height:.9;letter-spacing:-.07em;font-weight:500}.intro,.section p{color:var(--muted);font-size:1rem;line-height:1.65}.about-layout,.contact-layout{display:grid;grid-template-columns:1.35fr .65fr;gap:clamp(32px,7vw,100px)}.lead{font-size:clamp(1.7rem,3.5vw,3rem)!important;line-height:1.08!important;letter-spacing:-.04em;color:var(--text)!important}.focus{border-top:1px solid var(--line)}.focus div{padding:20px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:34px 1fr}.focus b{color:var(--mint);font-size:.7rem}.focus span{grid-column:2;color:var(--muted);font-size:.85rem;margin-top:5px}.timeline{display:grid}.role{display:grid;grid-template-columns:150px 1fr;gap:24px;padding:26px 4px;border-top:1px solid var(--line)}.role-date{color:var(--mint);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}.role-main{display:grid;grid-template-columns:58px 1fr;gap:16px;min-width:0}.role-logo{width:58px;height:58px;border:1px solid rgba(169,245,200,.24);background:#111b16;border-radius:16px;display:grid;place-items:center;padding:8px}.role-logo img{max-width:100%;max-height:100%;object-fit:contain}.role h3,.project h3{margin:0 0 5px;font-size:1.2rem;font-weight:500}.company{color:var(--muted);font-size:.86rem;margin-bottom:10px}.project-list{display:grid}.project{display:grid;grid-template-columns:minmax(180px,.55fr) 1.45fr;gap:28px;padding:22px 4px;border-top:1px solid var(--line)}.project-art{height:150px;border:1px solid rgba(169,245,200,.18);border-radius:16px;overflow:hidden;background:#101a15}.project-art img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.project:hover img{transform:scale(1.05)}.role-label{color:var(--mint);font-size:.75rem;margin-bottom:12px}.game-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin:28px 0}.game-grid span{min-height:78px;padding:18px;background:#101913;color:var(--muted);display:flex;align-items:center;font-size:.78rem;line-height:1.35}.archive-link{display:inline-block;color:var(--mint);border:1px solid rgba(169,245,200,.35);padding:12px 16px;text-decoration:none;font-size:.72rem;letter-spacing:.1em}.skill-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0 36px}.skill-grid article{padding:24px 4px;border-top:1px solid var(--line)}.skill-grid h3{margin:0 0 10px;font-size:1rem}.contact-details{border-top:1px solid var(--line)}.contact-details div{display:flex;justify-content:space-between;gap:20px;padding:17px 4px;border-bottom:1px solid rgba(169,245,200,.12);color:var(--muted);font-size:.9rem}.contact-details strong{color:var(--text);font-weight:400}
@media(max-width:700px){.home{min-height:100svh}.full-name{font-size:clamp(1.5rem,7.2vw,3rem)}.name p{font-size:8px;margin-top:14px}.float{width:82px}.float.about{left:5%;top:15%}.float.experience{right:5%;top:17%}.float.projects{left:7%;bottom:17%}.float.games{right:7%;bottom:18%}.float.skills{top:8%;margin-left:-41px}.float.contact{right:30%;bottom:7%}.home-meta{left:14px;bottom:18px;font-size:8px}.home-hint{right:14px;bottom:18px;font-size:8px}.content{padding:0 18px}.section{padding:76px 0 60px}.section-head{display:block}.page-icon{width:50px;height:50px;margin-bottom:24px}.about-layout,.contact-layout,.skill-grid{grid-template-columns:1fr;gap:34px}.role,.project{grid-template-columns:1fr;gap:12px}.role-main{grid-template-columns:50px 1fr}.role-logo{width:50px;height:50px}.project-art{height:205px}.game-grid{grid-template-columns:repeat(2,1fr)}.game-grid span{min-height:70px;padding:14px;font-size:.74rem}}
@media(prefers-reduced-motion:reduce){.particle,.float{animation:none}.bubble,.full-name,.boa-initial{transition:none}}
</style>

<script>
(() => {
  const name=document.getElementById("name");
  const orbit=document.getElementById("orbit");
  const mini=document.getElementById("mini");
  const home=document.getElementById("home");
  const sections=[...document.querySelectorAll(".section")];
  const bubbles=[...document.querySelectorAll(".bubble")];
  let selected=null, drag=null, timer=null, suppress=0, opening=false;

  setTimeout(()=>name.classList.add("expanded"),80);

  function homeState(){
    sections.forEach(s=>s.classList.add("collapsed"));
    orbit.classList.remove("scrolled");
    mini.classList.remove("visible");
    if(selected){
      const w=selected.parentElement;
      orbit.appendChild(w);
      w.classList.remove("selected-bubble","returning","dragging");
      w.style.removeProperty("--from-x");w.style.removeProperty("--from-y");
      selected.style.removeProperty("--dx");selected.style.removeProperty("--dy");
      selected=null;
    }
    name.classList.add("expanded");
    window.scrollTo({top:0,behavior:"smooth"});
  }

  function openSection(id){
    const chosen=bubbles.find(b=>b.dataset.section===id), target=document.getElementById("section-"+id);
    if(!chosen||!target) return;
    if(selected&&selected!==chosen) selected.parentElement.classList.remove("selected-bubble");
    opening=true; selected=chosen; name.classList.remove("expanded");
    const wrap=chosen.parentElement, source=wrap.getBoundingClientRect();
    sections.forEach(s=>s.classList.toggle("collapsed",s!==target));
    wrap.classList.add("selected-bubble");
    const head=target.querySelector(".section-head"), titleBox=head?.querySelector("div:nth-child(2)");
    if(titleBox){ titleBox.prepend(wrap); }
    wrap.style.setProperty("--from-x",(source.left-wrap.getBoundingClientRect().left)+"px");
    wrap.style.setProperty("--from-y",(source.top-wrap.getBoundingClientRect().top)+"px");
    target.scrollIntoView({behavior:"smooth",block:"start"});
    orbit.classList.add("scrolled");
    setTimeout(()=>opening=false,1000);
  }

  function returnBubble(d){
    const w=d.wrapper,b=d.bubble,dx=b.style.getPropertyValue("--dx")||"0px",dy=b.style.getPropertyValue("--dy")||"0px";
    w.classList.remove("dragging");b.classList.remove("dragging");w.style.setProperty("--return-x",dx);w.style.setProperty("--return-y",dy);w.classList.add("returning");
    b.style.setProperty("--dx","0px");b.style.setProperty("--dy","0px");
    setTimeout(()=>{w.classList.remove("returning");w.style.removeProperty("--return-x");w.style.removeProperty("--return-y");b.style.removeProperty("--dx");b.style.removeProperty("--dy")},850);
  }

  bubbles.forEach(b=>{
    b.addEventListener("pointerdown",e=>{
      if(e.pointerType==="mouse"&&e.button!==0)return;
      clearTimeout(timer);
      drag={bubble:b,wrapper:b.parentElement,id:e.pointerId,x:e.clientX,y:e.clientY,moved:false,dragging:false};
      timer=setTimeout(()=>{if(!drag)return;drag.dragging=true;b.classList.add("dragging");drag.wrapper.classList.add("dragging");try{b.setPointerCapture(e.pointerId)}catch(_){}},280);
    });
    b.addEventListener("pointermove",e=>{
      if(!drag||drag.id!==e.pointerId)return;
      const dx=e.clientX-drag.x,dy=e.clientY-drag.y;
      if(!drag.dragging){if(Math.hypot(dx,dy)>14){clearTimeout(timer);drag.moved=true}return}
      drag.moved=true;e.preventDefault();b.style.setProperty("--dx",dx+"px");b.style.setProperty("--dy",dy+"px");
    });
    b.addEventListener("pointerup",e=>{
      if(!drag||drag.id!==e.pointerId)return;
      clearTimeout(timer);const d=drag;drag=null;
      if(d.dragging){suppress=Date.now()+800;returnBubble(d);return}
      if(!d.moved&&Date.now()>suppress)openSection(b.dataset.section);
    });
    b.addEventListener("pointercancel",()=>{if(drag?.dragging)returnBubble(drag);drag=null;clearTimeout(timer)});
    b.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openSection(b.dataset.section)}});
  });

  mini.addEventListener("click",e=>{e.preventDefault();homeState()});
  window.addEventListener("scroll",()=>{
    const y=window.scrollY;
    if(y>home.offsetHeight*.3)mini.classList.add("visible");else mini.classList.remove("visible");
    if(selected&&!opening&&y<5)homeState();
  },{passive:true});
})();
</script>
</Layout>