---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { projects } from "../data/projects.js";
import { experience } from "../data/experience.js";
---
<Layout>
<div class="wrap">
<Header />
<section class="hero"><div><div class="kicker">Project Management · Game Production · Game Design</div><h1><span>Breno</span><span class="outline">Almeida.</span></h1><p class="intro">Project Manager and Game Producer connecting business, product, creative and technical teams to turn ideas into organized production and successful delivery.</p></div><aside class="side"><div class="availability"><i></i> São Paulo · Brazil</div><strong>10+ YEARS</strong><p>Experience across games, digital products, events, consulting and creative operations.</p><strong>NOW</strong><p>Focused on Project Management, PMO, Product Delivery and Game Production.</p></aside></section>
<section class="section" id="about"><div class="section-label">01 / Positioning</div><p class="statement">I bridge <em>creative vision</em> and <em>structured delivery</em> — from strategy and planning to production, teams, stakeholders and release.</p></section>
<section class="section" id="work"><div class="work-head"><div><div class="section-label">02 / Selected Work</div><h2>Projects that shipped.</h2></div><div class="filters"><button class="active" data-filter="all">ALL</button><button data-filter="games">GAMES</button><button data-filter="production">PRODUCTION</button></div></div><div class="work-grid">
{projects.map((p,i)=><article class:list={["work-card",i%2===0?"wide":"narrow"]} data-type={p.category}><div><span class="tag">{p.client} · {p.role}</span></div><div class="card-bottom"><div><h3>{p.title}</h3><p>{p.description}</p></div><span class="arrow">↗</span></div></article>)}
</div></section>
<section class="section" id="career"><div class="section-label">03 / Career Timeline</div><div class="timeline">
{experience.map(e=><article class="event"><div class="date">{e.period}</div><div class="event-body">{e.logo && <div class="event-logo"><img src={`/Resume/assets/experience/${encodeURIComponent(e.logo)}`} alt="" /></div>}<div class="event-copy"><h3>{e.company} · {e.role}</h3><p>{e.summary}</p></div></div></article>)}
</div></section>
<section class="section"><div class="section-label">04 / At a glance</div><div class="stats"><div class="stat"><b>10+</b><span>Years of experience</span></div><div class="stat"><b>100+</b><span>Projects led</span></div><div class="stat"><b>80+</b><span>Games in the archive</span></div></div></section>
<section class="section"><div class="section-label">05 / Selected Clients & Partners</div><div class="client-wall">{["Ubisoft","Paradox Interactive","Mattel","GameMill","Roblox","Sony","Tencent","ByteDance","Nickelodeon","SEBRAE"].map(client=><span>{client}</span>)}</div></section>
<section class="section" id="contact"><div class="contact"><div><div class="section-label">06 / Contact</div><h2>Let's build<br/>something.</h2></div><div><p>For opportunities in Project Management, PMO, Product, Game Production and multidisciplinary creative projects.</p><div class="links"><a href="mailto:brenodeoliveiraalmeida@gmail.com">Email ↗</a><a href="https://www.linkedin.com/in/brenotheboa/">LinkedIn ↗</a><a href="/Resume/games.html">Games Archive ↗</a></div></div></div></section>
</div>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f7f7f4;color:#111214;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(a){color:inherit;text-decoration:none}
.wrap{max-width:1160px;margin:auto;padding:0 28px}.nav{height:76px;border-bottom:1px solid #dedfdd;display:flex;align-items:center;justify-content:space-between}.logo{font-weight:900;font-size:20px;letter-spacing:-.07em}.nav nav{display:flex;gap:10px}.nav nav a{font-size:12px;color:#74777d;padding:10px}.hero{padding:85px 0 95px;min-height:620px;display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:80px;align-items:end}.kicker,.section-label,.tag{font-size:11px;text-transform:uppercase;letter-spacing:.17em;color:#74777d}.kicker{margin-bottom:22px}.hero h1{font-size:clamp(58px,9vw,122px);line-height:.82;letter-spacing:-.09em;margin:0 0 35px;font-weight:850}.hero h1 span{display:block}.outline{color:transparent;-webkit-text-stroke:1.5px #111214}.intro{font-size:20px;line-height:1.5;max-width:680px;color:#45484e}.side{border-left:1px solid #dedfdd;padding-left:28px;font-size:13px;line-height:1.7;color:#74777d}.side strong{display:block;color:#111214;font-size:13px;margin-top:20px}.availability{display:flex;align-items:center;gap:8px;margin-bottom:28px}.availability i{width:7px;height:7px;border-radius:50%;background:#111;box-shadow:0 0 0 5px #e3e3df}.section{border-top:1px solid #dedfdd;padding:76px 0}.statement{font-size:clamp(30px,4.5vw,58px);line-height:1.02;letter-spacing:-.065em;max-width:1000px;margin:30px 0 0}.statement em{font-style:normal;color:#74777d}.work-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:26px}.work-head h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 0}.filters{display:flex;gap:5px}.filters button{border:1px solid #dedfdd;background:transparent;padding:8px 11px;font-size:11px;cursor:pointer;color:#74777d}.filters button.active{background:#111214;color:#fff;border-color:#111214}.work-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.work-card{background:#eeefeb;min-height:300px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;transition:transform .35s,background .35s}.work-card:hover{transform:translateY(-6px);background:#e7e8e3}.wide{grid-column:span 7}.narrow{grid-column:span 5}.card-bottom{display:flex;justify-content:space-between;align-items:end}.work-card h3{font-size:30px;letter-spacing:-.06em;margin:8px 0}.work-card p{font-size:13px;line-height:1.5;color:#666970;max-width:390px;margin:0}.arrow{font-size:21px}.timeline{position:relative;margin-top:30px}.timeline:before{content:"";position:absolute;left:108px;top:0;bottom:0;width:1px;background:#dedfdd}.event{display:grid;grid-template-columns:180px 1fr;min-height:100px;position:relative}.date{font-size:11px;color:#74777d;padding-top:4px}.event-body{padding:0 0 38px 40px;display:grid;grid-template-columns:64px 1fr;gap:18px}.event-logo{width:64px;height:64px;border:1px solid #dedfdd;background:#fff;display:grid;place-items:center;padding:8px}.event-logo img{width:100%;height:100%;object-fit:contain}.event-copy{}.event-body:before{content:"";position:absolute;left:103px;top:2px;width:10px;height:10px;background:#f7f7f4;border:2px solid #111214;border-radius:50%}.event h3{margin:0 0 4px;font-size:18px;letter-spacing:-.025em}.event p{margin:0;color:#74777d;font-size:13px;line-height:1.5}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#dedfdd;border:1px solid #dedfdd;margin-top:30px}.stat{background:#f7f7f4;padding:28px}.stat b{display:block;font-size:42px;letter-spacing:-.07em}.stat span{font-size:11px;color:#74777d;text-transform:uppercase;letter-spacing:.1em}.contact{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:end}.contact h2{font-size:clamp(42px,6vw,75px);line-height:.9;letter-spacing:-.075em;margin:30px 0 0}.contact p{color:#74777d;line-height:1.6;font-size:14px}.links{display:flex;gap:8px;margin-top:20px;flex-wrap:wrap}.links a{border:1px solid #111214;padding:11px 14px;font-size:12px}.links a:hover{background:#111214;color:#fff}.client-wall{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid #dedfdd;margin-top:30px}.client-wall span{padding:24px 18px;border-right:1px solid #dedfdd;border-bottom:1px solid #dedfdd;font-size:13px;font-weight:600;letter-spacing:-.02em}.client-wall span:nth-child(5n){border-right:0}@media(max-width:700px){.nav nav{display:none}.hero{grid-template-columns:1fr;gap:40px;padding:65px 0}.side{border-left:0;border-top:1px solid #dedfdd;padding:22px 0 0}.work-grid{grid-template-columns:1fr}.wide,.narrow{grid-column:auto}.event{grid-template-columns:100px 1fr}.timeline:before{left:100px}.event-body{padding-left:25px;grid-template-columns:48px 1fr}.event-logo{width:48px;height:48px}.event-body:before{left:95px}.stats{grid-template-columns:1fr}.client-wall{grid-template-columns:repeat(2,1fr)}.client-wall span:nth-child(5n){border-right:1px solid #dedfdd}.client-wall span:nth-child(2n){border-right:0}.contact{grid-template-columns:1fr;gap:35px}}</style>
<script>
const filters=document.querySelectorAll("[data-filter]"),cards=document.querySelectorAll(".work-card");
filters.forEach(f=>f.addEventListener("click",()=>{filters.forEach(x=>x.classList.remove("active"));f.classList.add("active");const t=f.dataset.filter;cards.forEach(c=>c.style.display=t==="all"||c.dataset.type===t?"flex":"none")}));
</script>
</Layout>