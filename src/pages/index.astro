---
import Layout from "../layouts/Layout.astro";
import { projects, gameProjects } from "../data/projects.js";
import { experience } from "../data/experience.js";

const artwork = {
  "The Division Resurgence":"The Division Resurgence.png",
  "Hearts of Iron IV: Trial of Allegiance":"Heats of Iron IV Trial of Allegiance.png",
  "Cobra Kai: The Karate Kid Saga Continues":"Cobra Kai The Karate Kid Saga Continues.png",
  "Age of Rivals: Conquest":"Age of Rivals Conquest.png",
  "So Fart Away":"So Fart Away.png"
};
---

<Layout>
<section class="home" id="home">
  <div class="particles" aria-hidden="true">
    <span style="--x:8%;--size:12px;--alpha:.35;--duration:14s;--delay:-4s;--drift:25px;--sway:7s;--sway-x:14px;--blur:3px"></span>
    <span style="--x:19%;--size:18px;--alpha:.22;--duration:18s;--delay:-11s;--drift:-18px;--sway:9s;--sway-x:20px;--blur:4px"></span>
    <span style="--x:31%;--size:9px;--alpha:.3;--duration:16s;--delay:-7s;--drift:22px;--sway:8s;--sway-x:12px;--blur:2px"></span>
    <span style="--x:43%;--size:15px;--alpha:.2;--duration:21s;--delay:-15s;--drift:-28px;--sway:11s;--sway-x:22px;--blur:5px"></span>
    <span style="--x:57%;--size:11px;--alpha:.28;--duration:17s;--delay:-9s;--drift:19px;--sway:8s;--sway-x:15px;--blur:3px"></span>
    <span style="--x:68%;--size:20px;--alpha:.18;--duration:20s;--delay:-13s;--drift:-24px;--sway:10s;--sway-x:24px;--blur:5px"></span>
    <span style="--x:81%;--size:10px;--alpha:.32;--duration:15s;--delay:-5s;--drift:20px;--sway:7s;--sway-x:13px;--blur:2px"></span>
    <span style="--x:92%;--size:16px;--alpha:.2;--duration:19s;--delay:-10s;--drift:-17px;--sway:9s;--sway-x:19px;--blur:4px"></span>
  </div>

  <div class="interaction-hint" aria-hidden="true"><span>PRESS &amp; HOLD TO MOVE</span></div>

  <div class="name" id="name">
    <div class="title-wrap">
      <span class="boa-initial" aria-hidden="true"><span class="upper">B</span><span class="upper">O</span><span class="upper">A</span></span>
      <h1 class="full-name" aria-label="Breno de Oliveira Almeida"><span class="upper">B</span>reno <span class="upper">d</span>e <span class="upper">O</span>liveira <span class="upper">A</span>lmeida</h1>
    </div>
  </div>

  <div class="orbit" id="orbit" aria-label="Portfolio sections">
    <div class="float about"><button class="bubble" data-section="about" aria-label="Open About">About</button></div>
    <div class="float experience"><button class="bubble" data-section="experience" aria-label="Open Experience">Experience</button></div>
    <div class="float projects"><button class="bubble" data-section="projects" aria-label="Open Projects">Projects</button></div>
    <div class="float skills"><button class="bubble" data-section="skills" aria-label="Open Skills">Skills</button></div>
    <div class="float contact"><button class="bubble" data-section="contact" aria-label="Open Contact">Contact</button></div>
  </div>
</section>

<div class="scrollbar"><button class="mini" id="mini" aria-label="Return home">BOA</button></div>

<main class="content">
  <section class="section collapsed" id="section-about">
    <div class="section-head">
      <div class="page-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="3"/><path d="M5 20c.8-4 3.1-6 7-6s6.2 2 7 6"/></svg></div>
      <div><h2 aria-hidden="true"></h2></div>
      <p class="section-intro">I turn complex ideas into clear, shippable experiences.</p>
    </div>
    <div class="about-layout">
      <div class="about-story">
        <p class="about-lead">I'm Breno — Project Manager, Game Producer and Game Designer working across technology, games and creative products.</p>
        <p>I like being where strategy meets execution: turning ambiguity into plans, connecting people and disciplines, and keeping teams moving toward something real.</p>
        <p>My background spans game development, production, consulting, events and creative education.</p>
      </div>
      <div class="about-focus">
        <div class="focus-item"><span>01</span><strong>Structure</strong><small>Turn complexity into a workable path.</small></div>
        <div class="focus-item"><span>02</span><strong>People</strong><small>Align teams around shared outcomes.</small></div>
        <div class="focus-item"><span>03</span><strong>Delivery</strong><small>Move ideas from concept to shipped.</small></div>
      </div>
    </div>
    <div class="about-meta"><span>São Paulo, Brazil</span><span>Project Management · Game Production · Design</span><span>TheBOA.Games</span></div>
  </section>

  <section class="section collapsed" id="section-experience">
    <div class="section-head">
      <div class="page-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5h8v2M3 12h18M10 12v2h4v-2"/></svg></div>
      <div><h2>Experience</h2></div>
    </div>
    <p class="section-intro">More than a decade moving between creative production, games, events, consulting and project management.</p>
    <div class="timeline">
      {experience.map(e => <article class="role">
        <div class="role-date">{e.period}</div>
        <div class="role-main">
          {e.logo && <div class="role-logo"><img loading="lazy" decoding="async" src={`${import.meta.env.BASE_URL}assets/${e.logoFolder || "experience"}/${encodeURIComponent(e.logo)}`} alt={`${e.company} logo`} /></div>}
          <div><h3>{e.role}</h3><div class="role-company">{e.company}</div><p>{e.summary}</p></div>
        </div>
      </article>)}
    </div>
  </section>

  <section class="section collapsed" id="section-projects">
    <div class="section-head">
      <div class="page-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m8 6-5 6 5 6M16 6l5 6-5 6M14 4l-4 16"/></svg></div>
      <div><h2>Projects</h2></div>
    </div>
    <p class="section-intro">Selected work first, followed by the complete archive — all presented inside the same V29 experience.</p>

    <div class="featured-heading"><span>SELECTED WORK</span><small>Featured projects</small></div>
    <div class="featured-projects">
      {projects.map((p,index) => <article class="featured-project">
        <div class="featured-number">{String(index+1).padStart(2,"0")}</div>
        <div class="featured-art">{artwork[p.title] && <img loading="lazy" decoding="async" src={`${import.meta.env.BASE_URL}assets/projects/${encodeURIComponent(artwork[p.title])}`} alt={`${p.title} artwork`} />}<span class="featured-category">{p.category === "production" ? "PRODUCTION" : "GAME PRODUCTION"}</span></div>
        <div class="featured-copy"><div class="meta">{p.client}</div><h3>{p.title}</h3><div class="role-label">{p.role}</div><p>{p.description}</p></div>
      </article>)}
    </div>

    <div class="archive-heading"><span>COMPLETE ARCHIVE</span><small>{gameProjects.length}+ games &amp; interactive projects</small></div>
    <div class="game-archive">
      {gameProjects.map((title,i) => <article class="archive-game"><span class="archive-index">{String(i+1).padStart(2,"0")}</span><h3>{title}</h3></article>)}
    </div>

  <section class="section collapsed" id="section-skills">
    <div class="section-head">
      <div class="page-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l2.4 5.1L20 9l-4 4 .9 5.7-4.9-2.6-4.9 2.6L8 13 4 9l5.6-.9z"/><path d="M12 13v7"/></svg></div>
      <div><h2>Skills</h2></div>
    </div>
    <p class="section-intro">A hybrid toolkit built from creative production and formal project-management practice.</p>
    <div class="skill-groups">
      <article class="skill-group"><h3>Project Management</h3><p>Agile · Scrum · Kanban · PMO · Roadmaps · Scope · Risk · Stakeholder Management · Planning · Delivery</p></article>
      <article class="skill-group"><h3>Strategy & Operations</h3><p>Discovery · Strategic Planning · OKRs · Process Design · Business Development · Partnerships · Creative Operations</p></article>
      <article class="skill-group"><h3>Games</h3><p>Game Design · Game Production · Systems Design · UGC · Prototyping · Publishing · Live Operations</p></article>
      <article class="skill-group"><h3>Tools</h3><p>ClickUp · Jira · Trello · Confluence · Notion · Monday · Miro · Figma · Google Workspace</p></article>
      <article class="skill-group"><h3>Engines & Creation</h3><p>Unreal Engine · Unity · UEFN · Godot · Roblox Studio · GameMaker · Construct · Blender · Aseprite · Photoshop</p></article>
      <article class="skill-group"><h3>Languages</h3><p>Portuguese — native · English — fluent · French — strong reading · Spanish — comprehension</p></article>
    </div>
  </section>

  <section class="section collapsed" id="section-contact">
    <div class="section-head">
      <div class="page-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></div>
      <div><h2>Contact</h2></div>
    </div>
    <div class="contact-layout">
      <div><p class="contact-big">Let's build something worth shipping.</p><p class="section-intro">Available for project management, game production, creative operations, consulting and selected collaborations.</p></div>
      <div class="contact-details">
        <div class="contact-row"><span>Location</span><strong>São Paulo, Brazil</strong></div>
        <div class="contact-row"><span>Role focus</span><strong>Project Management / Game Production</strong></div>
        <div class="contact-row"><span>Studio</span><strong>TheBOA.Games</strong></div>
        <div class="contact-row"><span>Brand</span><strong>BOA.Productions</strong></div>
      </div>
    </div>
  </section>
</main>

<script>
(() => {
  const orbit=document.getElementById("orbit"), mini=document.getElementById("mini"), name=document.getElementById("name"), home=document.getElementById("home");
  const sections=[...document.querySelectorAll(".section")], bubbles=[...document.querySelectorAll(".bubble")];
  let selectedBubble=null, openingSection=false;
  let carouselAngle=0, carouselStartAngle=0, activeIndex=0;
  let gesture=null;

  const TAU=Math.PI*2;
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const shortest=(a,b)=>((a-b+Math.PI)%TAU+TAU)%TAU-Math.PI;

  function expand(){name.classList.remove("collapsing");name.classList.add("expanded")}
  function collapse(){name.classList.remove("expanded");name.classList.add("collapsing")}

  function carouselLayout(){
    const w=window.innerWidth, h=window.innerHeight;
    const bubbleSize=Math.min(Math.max(w*.09,82),116);
    const cx=w/2;
    const nameRect=name.getBoundingClientRect();
    const nameBottom=nameRect.bottom;
    const safeTop=Math.max(72,nameRect.top-bubbleSize*.55);
    const safeBottom=Math.min(h-72,nameBottom+bubbleSize*.95);
    const topY=Math.max(bubbleSize/2+24,safeTop-bubbleSize*.05);
    const bottomY=Math.min(h-bubbleSize/2-24,safeBottom);
    const topHalf=Math.max(150,w*.34);
    const upperCount=bubbles.length-1;
    const positions=[];
    for(let i=0;i<upperCount;i++){
      const t=upperCount===1?.5:i/(upperCount-1);
      const x=cx + (t-.5)*topHalf*2;
      const y=topY - Math.sin(t*Math.PI)*Math.min(52,h*.07);
      positions.push({x,y});
    }
    return {bubbleSize,cx,bottomY,positions};
  }

  function applyCarousel(angle=carouselAngle, animate=false){
    carouselAngle=angle;
    const {bubbleSize,cx,bottomY,positions}=carouselLayout();
    const step=TAU/bubbles.length;
    const order=[...bubbles.keys()].sort((a,b)=>{
      const aa=((a-activeIndex)%bubbles.length+bubbles.length)%bubbles.length;
      const bb=((b-activeIndex)%bubbles.length+bubbles.length)%bubbles.length;
      return aa-bb;
    });
    const active=bubbles[activeIndex];
    bubbles.forEach((bubble,i)=>{
      const wrapper=bubble.parentElement;
      let x,y;
      if(i===activeIndex){
        x=cx; y=bottomY;
      }else{
        const rank=order.indexOf(i)-1;
        const p=positions[clamp(rank,0,positions.length-1)];
        x=p.x; y=p.y;
      }
      wrapper.style.setProperty("--orbit-x",(x-cx)+"px");
      wrapper.style.setProperty("--orbit-y",(y-h/2)+"px");
      wrapper.classList.toggle("carousel-active",i===activeIndex);
      wrapper.style.zIndex=i===activeIndex?"30":"10";
      wrapper.style.setProperty("--elastic",(animate?"1":"0"));
    });
    orbit.classList.toggle("carousel-animating",animate);
    if(animate) window.setTimeout(()=>orbit.classList.remove("carousel-animating"),620);
  }

  function setActiveIndex(index,animate=true){
    activeIndex=((index%bubbles.length)+bubbles.length)%bubbles.length;
    applyCarousel(carouselAngle,animate);
  }

  function rotateBy(delta,animate=false){
    const step=TAU/bubbles.length;
    carouselAngle=carouselStartAngle+delta;
    const direction=delta>=0?1:-1;
    if(Math.abs(delta)>step*.42){
      const moved=Math.round(delta/step);
      activeIndex=((activeIndex-moved*direction)%bubbles.length+bubbles.length)%bubbles.length;
      carouselStartAngle=carouselAngle;
    }
    applyCarousel(carouselAngle,animate);
  }

  function snapCarousel(){
    applyCarousel(carouselAngle,true);
  }

  function clearSelectedBubble(){
    if(!selectedBubble)return;
    const wrapper=selectedBubble.parentElement;
    if(wrapper && wrapper.parentElement && !wrapper.parentElement.matches("#orbit")) orbit.appendChild(wrapper);
    wrapper?.classList.remove("selected-bubble","title-bubble","arriving","returning-title","dragging","morphing","landed","carousel-active");
    wrapper?.style.removeProperty("--from-x");
    wrapper?.style.removeProperty("--from-y");
    selectedBubble.classList.remove("dragging","returning");
    selectedBubble.style.removeProperty("--dx");
    selectedBubble.style.removeProperty("--dy");
    selectedBubble=null;
    applyCarousel(carouselAngle,false);
  }

  function restoreHome(){
    clearSelectedBubble();
    sections.forEach(section=>{
      section.classList.add("collapsed");
      section.classList.remove("has-morph-title");
      section.querySelector(".section-head")?.classList.remove("has-selected-bubble");
    });
    orbit.classList.remove("scrolled","transitioning","returning-home");
    orbit.style.opacity="1";
    mini.classList.remove("visible");
    carouselAngle=0;
    activeIndex=0;
    applyCarousel(0,false);
    expand();
    window.scrollTo({top:0,behavior:"smooth"});
  }

  function returnToHomeManually(){
    if(openingSection)return;
    const chosen=selectedBubble;
    sections.forEach(section=>{
      section.classList.add("collapsed");
      section.classList.remove("has-morph-title");
      section.querySelector(".section-head")?.classList.remove("has-selected-bubble");
    });
    orbit.classList.remove("scrolled","transitioning");
    orbit.classList.add("returning-home");
    orbit.style.opacity="1";
    mini.classList.remove("visible");

    if(!chosen){restoreHome();return}

    const wrapper=chosen.parentElement;
    const sourceRect=wrapper.getBoundingClientRect();
    orbit.appendChild(wrapper);
    applyCarousel(carouselAngle,false);
    const targetRect=wrapper.getBoundingClientRect();
    const dx=sourceRect.left-targetRect.left+(sourceRect.width-targetRect.width)/2;
    const dy=sourceRect.top-targetRect.top+(sourceRect.height-targetRect.height)/2;

    wrapper.classList.remove("arriving","landed");
    wrapper.classList.add("selected-bubble","returning-title");
    wrapper.style.setProperty("--from-x",dx+"px");
    wrapper.style.setProperty("--from-y",dy+"px");

    requestAnimationFrame(()=>wrapper.classList.add("returning-title"));

    window.setTimeout(()=>{
      bubbles.forEach(bubble=>{
        const w=bubble.parentElement;
        w.classList.remove("selected-bubble","returning-title","title-bubble","arriving","landed","dragging","morphing");
        w.style.removeProperty("opacity");
        w.style.removeProperty("pointer-events");
        bubble.style.removeProperty("--dx");
        bubble.style.removeProperty("--dy");
      });
      orbit.classList.remove("returning-home","scrolled","transitioning");
      orbit.style.opacity="1";
      selectedBubble=null;
      carouselAngle=0;
      activeIndex=0;
      applyCarousel(0,false);
      expand();
      window.scrollTo({top:0,behavior:"smooth"});
    },1320);
  }

  function openSection(id){
    const chosen=bubbles.find(b=>b.dataset.section===id);
    const target=document.getElementById("section-"+id);
    if(!chosen||!target||openingSection)return;

    openingSection=true;
    selectedBubble=chosen;
    const wrapper=chosen.parentElement;
    const sourceRect=wrapper.getBoundingClientRect();
    const head=target.querySelector(".section-head");
    const titleBox=head?.querySelector(":scope > div");
    const title=head?.querySelector("h2");
    if(!head||!titleBox||!title){openingSection=false;return}

    collapse();
    sections.forEach(section=>{
      const active=section===target;
      section.classList.toggle("collapsed",!active);
      section.classList.toggle("has-morph-title",active);
      section.querySelector(".section-head")?.classList.toggle("has-selected-bubble",active);
    });

    orbit.classList.add("scrolled","transitioning");
    title.style.display="none";

    window.setTimeout(()=>target.scrollIntoView({behavior:"smooth",block:"start"}),120);

    titleBox.insertBefore(wrapper,title);
    wrapper.classList.remove("selected-bubble");
    wrapper.classList.add("title-bubble","arriving");

    const targetRect=wrapper.getBoundingClientRect();
    const dx=sourceRect.left-targetRect.left+(sourceRect.width-targetRect.width)/2;
    const dy=sourceRect.top-targetRect.top+(sourceRect.height-targetRect.height)/2;
    wrapper.style.setProperty("--from-x",dx+"px");
    wrapper.style.setProperty("--from-y",dy+"px");

    requestAnimationFrame(()=>wrapper.classList.add("arriving"));

    window.setTimeout(()=>{
      wrapper.classList.remove("arriving");
      wrapper.classList.add("landed");
      wrapper.style.removeProperty("--from-x");
      wrapper.style.removeProperty("--from-y");
      orbit.classList.remove("transitioning");
      target.scrollIntoView({behavior:"smooth",block:"start"});
      window.setTimeout(()=>{openingSection=false},650);
    },1350);
  }

  function finishGesture(e){
    if(!gesture||gesture.id!==e.pointerId)return;
    const g=gesture;
    gesture=null;
    try{orbit.releasePointerCapture(e.pointerId)}catch(_){}
    const dx=e.clientX-g.x, dy=e.clientY-g.y;
    const horizontal=Math.abs(dx)>Math.abs(dy);
    if(horizontal && Math.abs(dx)>18){
      snapCarousel();
      return;
    }
    if(!horizontal && dy < -55){
      snapCarousel();
      openSection(bubbles[activeIndex].dataset.section);
      return;
    }
    if(horizontal) snapCarousel();
  }

  orbit.addEventListener("pointerdown",e=>{
    if(openingSection)return;
    if(e.pointerType==="mouse"&&e.button!==0)return;
    gesture={id:e.pointerId,x:e.clientX,y:e.clientY,startAngle:carouselAngle,moved:false};
    carouselStartAngle=carouselAngle;
    try{orbit.setPointerCapture(e.pointerId)}catch(_){}
  });

  orbit.addEventListener("pointermove",e=>{
    if(!gesture||gesture.id!==e.pointerId)return;
    const dx=e.clientX-gesture.x,dy=e.clientY-gesture.y;
    if(Math.hypot(dx,dy)<8)return;
    gesture.moved=true;
    if(Math.abs(dx)>=Math.abs(dy)){
      e.preventDefault();
      const sensitivity=Math.min(0.012,Math.max(0.007,1/window.innerWidth));
      rotateBy(dx*sensitivity,false);
    }
  });

  orbit.addEventListener("pointerup",finishGesture);
  orbit.addEventListener("pointercancel",finishGesture);
  orbit.addEventListener("lostpointercapture",e=>{if(gesture?.id===e.pointerId)finishGesture(e)});

  bubbles.forEach((b,i)=>{
    b.addEventListener("click",e=>{
      e.preventDefault();
      if(openingSection)return;
      setActiveIndex(i,true);
      window.setTimeout(()=>openSection(b.dataset.section),120);
    });
    b.addEventListener("keydown",e=>{
      if(e.key==="Enter"||e.key===" "){
        e.preventDefault();
        setActiveIndex(i,true);
        window.setTimeout(()=>openSection(b.dataset.section),120);
      }
    });
  });

  mini.addEventListener("click",e=>{e.preventDefault();e.stopPropagation();returnToHomeManually()});

  window.addEventListener("scroll",()=>{
    const y=window.scrollY;
    if(y>home.offsetHeight*.3)mini.classList.add("visible");else mini.classList.remove("visible");
    if(selectedBubble&&!openingSection&&y<=4)returnToHomeManually();
  },{passive:true});

  window.addEventListener("resize",()=>applyCarousel(carouselAngle,false));
  applyCarousel(0,false);
  setTimeout(expand,80);
})();
</script>

<style>
:global(:root){--bg:#06100c;--text:#f2f8f4;--muted:#9aada4;--mint:#a9f5c8;--line:rgba(169,245,200,.18)}
:global(*){box-sizing:border-box}:global(html){margin:0;padding:0;scroll-behavior:smooth}:global(body){margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif;overflow-x:hidden;min-height:100dvh}
.home{position:relative;width:100%;height:100vh;height:100svh;height:100dvh;min-height:0;overflow:hidden;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 50%,rgba(169,245,200,.055),transparent 38%),var(--bg)}
.particles{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0}.particles span{position:absolute;bottom:-12vh;left:var(--x);width:var(--size);height:var(--size);border-radius:50%;border:1px solid rgba(169,245,200,var(--alpha));background:radial-gradient(circle at 32% 28%,rgba(255,255,255,calc(var(--alpha)*.75)) 0 7%,rgba(169,245,200,calc(var(--alpha)*.28)) 8% 28%,rgba(169,245,200,calc(var(--alpha)*.08)) 52%,transparent 72%);box-shadow:0 0 var(--glow,18px) rgba(169,245,200,calc(var(--alpha)*.32)),inset 0 0 calc(var(--size)*.16) rgba(255,255,255,calc(var(--alpha)*.12));filter:blur(var(--blur));opacity:var(--alpha);animation:rise var(--duration) linear var(--delay) infinite,sway var(--sway) ease-in-out var(--delay) infinite alternate}
@keyframes rise{0%{transform:translate3d(0,12vh,0) scale(.72);opacity:0}8%{opacity:var(--alpha)}72%{opacity:calc(var(--alpha)*.72)}100%{transform:translate3d(var(--drift),-125vh,0) scale(1.12);opacity:0}}
@keyframes sway{0%{margin-left:calc(var(--sway-x)*-1)}50%{margin-left:var(--sway-x)}100%{margin-left:calc(var(--sway-x)*-.35)}}
.interaction-hint{position:absolute;left:50%;bottom:7.5%;transform:translateX(-50%);z-index:4;color:rgba(169,245,200,.42);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;opacity:0;animation:hintIn 1.2s ease 2.2s forwards;pointer-events:none;white-space:nowrap}.interaction-hint span{display:inline-block;padding:7px 11px;border:1px solid rgba(169,245,200,.1);border-radius:999px;background:rgba(6,16,12,.24)}@keyframes hintIn{to{opacity:1}}
