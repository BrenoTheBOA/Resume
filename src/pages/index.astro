---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { projects } from "../data/projects.js";
import { experience } from "../data/experience.js";
---

<Layout>
<div class="wrap">
<Header />

<section class="hero">
  <div>
    <div class="kicker">Project Management · Game Production · Game Design</div>
    <h1><span>Breno</span><span class="outline">Almeida.</span></h1>
    <p class="intro">Project Manager and Game Producer connecting business, product, creative and technical teams to turn ideas into organized production and successful delivery.</p>
  </div>
  <aside class="side">
    <div class="availability"><i></i> São Paulo · Brazil</div>
    <strong>10+ YEARS</strong>
    <p>Experience across games, digital products, events, consulting and creative operations.</p>
    <strong>NOW</strong>
    <p>Focused on Project Management, PMO, Product Delivery and Game Production.</p>
  </aside>
</section>

<section class="section" id="about">
  <div class="section-label">01 / Positioning</div>
  <p class="statement">I bridge <em>creative vision</em> and <em>structured delivery</em> — from strategy and planning to production, teams, stakeholders and release.</p>
</section>

<section class="section" id="work">
  <div class="work-head">
    <div><div class="section-label">02 / Selected Work</div><h2>Projects that shipped.</h2></div>
    <div class="filters" aria-label="Project filters">
      <button class="active" data-filter="all">ALL</button>
      <button data-filter="games">GAMES</button>
      <button data-filter="production">PRODUCTION</button>
    </div>
  </div>

  <div class="work-grid">
    {projects.map((p,i)=>
      <article class:list={["work-card",i===0?"hero-card":"",i%2===0?"wide":"narrow"]} data-type={p.category}>
        <div class="project-media">
          <img src={`/Resume/assets/projects/${encodeURIComponent(p.image)}`} alt={p.title} loading={i>1?"lazy":"eager"} />
          <span class="media-shade"></span>
          <span class="tag">{p.client} · {p.role}</span>
        </div>
        <div class="card-bottom">
          <div><h3>{p.title}</h3><p>{p.description}</p></div>
          <span class="arrow">↗</span>
        </div>
      </article>
    )}
  </div>
</section>

<section class="section" id="career">
  <div class="section-label">03 / Career Timeline</div>
  <div class="timeline">
    {experience.map(e=>
      <article class="event">
        <div class="date">{e.period}</div>
        <div class="event-body">
          {e.logo && <div class="event-logo"><img src={`/Resume/assets/experience/${encodeURIComponent(e.logo)}`} alt="" loading="lazy" /></div>}
          <div class="event-copy"><h3>{e.company} · {e.role}</h3><p>{e.summary}</p></div>
        </div>
      </article>
    )}
  </div>
</section>

<section class="section">
  <div class="section-label">04 / At a glance</div>
  <div class="stats">
    <div class="stat"><b>10+</b><span>Years of experience</span></div>
    <div class="stat"><b>100+</b><span>Projects led</span></div>
    <div class="stat"><b>80+</b><span>Games in the archive</span></div>
  </div>
</section>

<section class="section">
  <div class="section-label">05 / Selected Clients & Partners</div>
  <div class="client-wall">
    {[
      "Ubisoft.png","Paradox.png","Mattel.png","GameMill.png","Roblox.png",
      "Sony.png","Tencent.png","ByteDance.png","Nickelodeon.png","Sebrae.png"
    ].map((logo)=><div class="client-logo"><img src={`/Resume/assets/clients/${encodeURIComponent(logo)}`} alt={logo.replace(".png","")} loading="lazy" /></div>)}
  </div>
</section>

<section class="section" id="contact">
  <div class="contact">
    <div><div class="section-label">06 / Contact</div><h2>Let's build<br/>something.</h2></div>
    <div>
      <p>For opportunities in Project Management, PMO, Product, Game Production and multidisciplinary creative projects.</p>
      <div class="links"><a href="mailto:brenodeoliveiraalmeida@gmail.com">Email ↗</a><a href="https://www.linkedin.com/in/brenotheboa/">LinkedIn ↗</a><a href="/Resume/games">Games Archive ↗</a></div>
    </div>
  </div>
</section>
</div>

<style>
:global(*){box-sizing:border-box}
:global(body){margin:0;background:#f7f7f4;color:#111214;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
:global(a){color:inherit;text-decoration:none}
.wrap{max-width:1160px;margin:auto;padding:0 28px}
.nav{height:76px;border-bottom:1px solid #dedfdd;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-weight:900;font-size:20px;letter-spacing:-.07em;flex:none}
.nav nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}.nav nav::-webkit-scrollbar{display:none}
.nav nav a{font-size:12px;color:#74777d;padding:10px;white-space:nowrap}.nav nav a:hover{color:#111214}
.hero{padding:85px 0 95px;min-height:620px;display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:80px;align-items:end}
.kicker,.section-label,.tag{font-size:11px;text-transform:uppercase;letter-spacing:.17em;color:#74777d}
.kicker{margin-bottom:22px}
.hero h1{font-size:clamp(64px,9vw,122px);line-height:.82;letter-spacing:-.09em;margin:0 0 35px;font-weight:850}.hero h1 span{display:block}.outline{color:transparent;-webkit-text-stroke:1.5px #111214}
.intro{font-size:20px;line-height:1.5;max-width:680px;color:#45484e}
.side{border-left:1px solid #dedfdd;padding-left:28px;font-size:13px;line-height:1.7;color:#74777d}.side strong{display:block;color:#111214;font-size:13px;margin-top:20px}.availability{display:flex;align-items:center;gap:8px;margin-bottom:28px}.availability i{width:7px;height:7px;border-radius:50%;background:#111;box-shadow:0 0 0 5px #e3e3df}
.section{border-top:1px solid #dedfdd;padding:76px 0}
.statement{font-size:clamp(30px,4.5vw,58px);line-height:1.02;letter-spacing:-.065em;max-width:1000px;margin:30px 0 0}.statement em{font-style:normal;color:#74777d}
.work-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:26px;gap:20px}.work-head h2{font-size:32px;letter-spacing:-.05em;margin:10px 0 0}
.filters{display:flex;gap:5px;flex:none}.filters button{border:1px solid #dedfdd;background:transparent;padding:9px 11px;font-size:11px;cursor:pointer;color:#74777d}.filters button.active{background:#111214;color:#fff;border-color:#111214}
.work-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}
.work-card{background:#eeefeb;min-height:410px;padding:0;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;cursor:pointer;transition:transform .35s,background .35s;content-visibility:auto}
.work-card:hover{transform:translateY(-6px);background:#e7e8e3}
.wide{grid-column:span 7}.narrow{grid-column:span 5}.hero-card{min-height:470px}
.project-media{height:245px;position:relative;overflow:hidden;background:#dfe1dc}.hero-card .project-media{height:285px}
.project-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s cubic-bezier(.2,.7,.2,1)}.work-card:hover .project-media img{transform:scale(1.045)}
.media-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.42))}
.project-media .tag{position:absolute;left:22px;bottom:18px;color:#fff;z-index:1}
.card-bottom{display:flex;justify-content:space-between;align-items:end;gap:20px;padding:24px}.work-card h3{font-size:28px;letter-spacing:-.06em;margin:0 0 8px}.work-card p{font-size:13px;line-height:1.5;color:#666970;max-width:430px;margin:0}.arrow{font-size:21px;flex:none}
.timeline{position:relative;margin-top:30px}.timeline:before{content:"";position:absolute;left:108px;top:0;bottom:0;width:1px;background:#dedfdd}
.event{display:grid;grid-template-columns:180px 1fr;min-height:100px;position:relative}.date{font-size:11px;color:#74777d;padding-top:4px}.event-body{padding:0 0 38px 40px;display:grid;grid-template-columns:64px 1fr;gap:18px}.event-logo{width:64px;height:64px;border:1px solid #dedfdd;background:#fff;display:grid;place-items:center;padding:8px}.event-logo img{width:100%;height:100%;object-fit:contain}.event-body:before{content:"";position:absolute;left:103px;top:2px;width:10px;height:10px;background:#f7f7f4;border:2px solid #111214;border-radius:50%}.event h3{margin:0 0 5px;font-size:18px;letter-spacing:-.025em}.event p{margin:0;color:#74777d;font-size:13px;line-height:1.5}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#dedfdd;border:1px solid #dedfdd;margin-top:30px}.stat{background:#f7f7f4;padding:28px}.stat b{display:block;font-size:42px;letter-spacing:-.07em}.stat span{font-size:11px;color:#74777d;text-transform:uppercase;letter-spacing:.1em}
.client-wall{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:#dedfdd;border:1px solid #dedfdd;margin-top:30px}.client-logo{height:96px;background:#f7f7f4;display:grid;place-items:center;padding:20px;transition:background .25s}.client-logo:hover{background:#fff}.client-logo img{max-width:100%;max-height:48px;object-fit:contain;filter:grayscale(1);opacity:.68;transition:filter .25s,opacity .25s}.client-logo:hover img{filter:grayscale(0);opacity:1}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:end}.contact h2{font-size:clamp(42px,6vw,75px);line-height:.9;letter-spacing:-.075em;margin:30px 0 0}.contact p{color:#74777d;line-height:1.6;font-size:14px}.links{display:flex;gap:8px;margin-top:20px;flex-wrap:wrap}.links a{border:1px solid #111214;padding:11px 14px;font-size:12px}.links a:hover{background:#111214;color:#fff}
@media(max-width:700px){
  .wrap{padding:0 18px}.nav{height:64px}.nav nav a{font-size:11px;padding:9px 7px}
  .hero{grid-template-columns:1fr;gap:42px;padding:62px 0 70px;min-height:0}.kicker{line-height:1.5}.hero h1{font-size:clamp(66px,20vw,96px);margin-bottom:28px}.intro{font-size:18px;line-height:1.55}.side{border-left:0;border-top:1px solid #dedfdd;padding:22px 0 0}
  .section{padding:56px 0}.section-label{font-size:10px}.statement{font-size:34px;line-height:1.05;margin-top:22px}
  .work-head{display:block}.work-head h2{font-size:28px;margin-bottom:18px}.filters{overflow-x:auto;padding-bottom:2px}.filters button{min-height:40px}
  .work-grid{grid-template-columns:1fr;gap:10px}.wide,.narrow{grid-column:auto}.work-card,.hero-card{min-height:0}.project-media,.hero-card .project-media{height:205px}.card-bottom{padding:20px}.work-card h3{font-size:25px}.work-card p{font-size:14px}.arrow{font-size:24px}
  .timeline{margin-top:24px}.timeline:before{left:8px}.event{grid-template-columns:1fr;min-height:0;padding-left:26px}.event-body{padding:0 0 34px 0;grid-template-columns:50px 1fr;gap:14px}.event-logo{width:50px;height:50px}.event-body:before{left:3px;top:2px;width:9px;height:9px}.event h3{font-size:17px}.event p{font-size:14px;line-height:1.55}
  .stats{grid-template-columns:1fr}.stat{padding:24px}.stat b{font-size:46px}
  .client-wall{grid-template-columns:repeat(2,1fr)}.client-logo{height:82px;padding:16px}.client-logo img{max-height:38px}
  .contact{grid-template-columns:1fr;gap:35px}.contact h2{font-size:54px}
}
@media(prefers-reduced-motion:reduce){.work-card,.project-media img,.client-logo img{transition:none}}
</style>

<script>
const filters=document.querySelectorAll("[data-filter]"),cards=document.querySelectorAll(".work-card");
filters.forEach(f=>f.addEventListener("click",()=>{filters.forEach(x=>x.classList.remove("active"));f.classList.add("active");const t=f.dataset.filter;cards.forEach(c=>c.style.display=t==="all"||c.dataset.type===t?"flex":"none")}));
</script>
</Layout>