---
import Layout from "../layouts/Layout.astro";
import { gameProjects } from "../data/projects.js";
---
<Layout title="Games — Breno Almeida">
<div class="wrap"><header class="simple-nav"><a href="/Resume/">BOA.</a><a href="/Resume/#work">← Back</a></header>
<section class="hero"><div><div class="kicker">Portfolio · Games</div><h1>Game projects.</h1><p class="intro">A structured archive of games and interactive experiences from the existing portfolio. Detailed roles, years, platforms and case studies can be added progressively.</p></div></section>
<section class="section"><div class="game-list">{gameProjects.map((title,i)=><article class="game"><span>{String(i+1).padStart(2,"0")}</span><div><h2>{title}</h2><p>Project details to be expanded from the source portfolio.</p></div></article>)}</div></section>
</div>
<style>
:global(body){margin:0;background:#f7f7f4;color:#111214;font-family:Inter,system-ui,sans-serif}.wrap{max-width:1160px;margin:auto;padding:0 28px}.simple-nav{height:76px;border-bottom:1px solid #dedfdd;display:flex;justify-content:space-between;align-items:center}.simple-nav a:first-child{font-weight:900;letter-spacing:-.07em}.simple-nav a:last-child{font-size:12px;color:#74777d}.hero{padding:90px 0 70px}.kicker,.game>span{font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#74777d}.hero h1{font-size:clamp(52px,8vw,100px);line-height:.9;letter-spacing:-.08em;margin:20px 0}.intro{max-width:700px;font-size:19px;line-height:1.5;color:#45484e}.section{border-top:1px solid #dedfdd;padding:65px 0}.game-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#dedfdd;border:1px solid #dedfdd}.game{background:#f7f7f4;padding:22px;min-height:110px;display:grid;grid-template-columns:42px 1fr;gap:18px}.game h2{font-size:17px;letter-spacing:-.025em;margin:0 0 5px}.game p{margin:0;color:#74777d;font-size:12px}@media(max-width:700px){.game-list{grid-template-columns:1fr}}</style>