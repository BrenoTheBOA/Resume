---
import Layout from "../layouts/Layout.astro";
import { gameProjects } from "../data/projects.js";

const artworkMap = {
  "Black Tide":"Black Tide.png",
  "Shahnameh - Ascensão dos Reis":"Shahnameh.png",
  "Cobra Kai: The Karate Kid Saga Continues":"Cobra Kai The Karate Kid Saga Continues.png",
  "Deepersona":"DeePersona.png",
  "Get Out":"Get Out.png",
  "Nosferatu - Between Ink & Blood":"Nosferatu Between Ink & Blood.png",
  "Desert Rose":"Desert Rose.png",
  "STRAH":"Strah.png",
  "Plantaê":"Planta#U00ea.png",
  "The Division Resurgence":"The Division Resurgence.png",
  "Hearts of Iron IV: Trial of Allegiance":"Heats of Iron IV Trial of Allegiance.png",
  "Rapala Fishing":"Rapala Fishing.png",
  "Age of Rivals: Conquest":"Age of Rivals Conquest.png",
  "Quiz Geek!":"Quiz Geek.png",
  "LifeWind":"Lifewind.png",
  "Necromaniacs":"NecroManiacs.png",
  "Coffe Rush":"Coffee Rush.png",
  "The Legendary Rion":"The Legendary Rion.png",
  "Guild Hunters":"Guild Of Hunters.png",
  "So Fart Away":"So Fart Away.png",
  "A Shark Light":"A Shark Light.png"
};
---
<Layout title="Games — Breno Almeida">
<div class="wrap"><header class="simple-nav"><a href={import.meta.env.BASE_URL}>BOA.</a><a href={`${import.meta.env.BASE_URL}#work`}>← Back</a></header>
<section class="hero"><div><div class="kicker">Portfolio · Games</div><h1>Game projects.</h1><p class="intro">An archive of games and interactive experiences across production, design and development. Selected projects include artwork and deeper context; the archive keeps the breadth of the portfolio visible.</p></div></section>
<section class="section"><div class="archive-head"><div class="section-label">80+ projects</div><p>Selected visual references from the archive.</p></div><div class="game-list">{gameProjects.map((title,i)=><article class="game"><span>{String(i+1).padStart(2,"0")}</span>{artworkMap[title] && <div class="game-art"><img src={`${import.meta.env.BASE_URL}assets/projects/${encodeURIComponent(artworkMap[title])} alt="" loading="lazy" /></div>}<div class="game-copy"><h2>{title}</h2><p>{artworkMap[title] ? "Visual reference from the portfolio archive." : "Project details to be expanded from the source portfolio."}</p></div></article>)}</div></section>
</div>
<style>
:global(body){margin:0;background:#f7f7f4;color:#111214;font-family:Inter,system-ui,sans-serif}.wrap{max-width:1160px;margin:auto;padding:0 28px}.simple-nav{height:76px;border-bottom:1px solid #dedfdd;display:flex;justify-content:space-between;align-items:center}.simple-nav a:first-child{font-weight:900;letter-spacing:-.07em}.simple-nav a:last-child{font-size:12px;color:#74777d}.hero{padding:90px 0 70px}.kicker,.game>span,.section-label{font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:#74777d}.hero h1{font-size:clamp(52px,8vw,100px);line-height:.9;letter-spacing:-.08em;margin:20px 0}.intro{max-width:700px;font-size:19px;line-height:1.5;color:#45484e}.section{border-top:1px solid #dedfdd;padding:65px 0}.archive-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.archive-head p{margin:0;color:#74777d;font-size:13px}.game-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#dedfdd;border:1px solid #dedfdd}.game{background:#f7f7f4;min-height:128px;display:grid;grid-template-columns:34px 88px 1fr;gap:15px;align-items:center;padding:15px}.game>span{align-self:start;padding-top:6px}.game-art{width:88px;height:88px;overflow:hidden;background:#e6e7e3}.game-art img{width:100%;height:100%;object-fit:cover;display:block}.game-copy h2{font-size:17px;letter-spacing:-.025em;margin:0 0 6px}.game-copy p{margin:0;color:#74777d;font-size:12px;line-height:1.4}
@media(max-width:700px){.wrap{padding:0 18px}.hero{padding:62px 0 55px}.hero h1{font-size:clamp(56px,18vw,86px)}.intro{font-size:17px}.section{padding:48px 0}.archive-head{display:block}.archive-head p{margin-top:8px}.game-list{grid-template-columns:1fr}.game{grid-template-columns:28px 72px 1fr;gap:12px;min-height:104px;padding:12px}.game-art{width:72px;height:72px}.game-copy h2{font-size:16px}.game-copy p{font-size:12px}}
</style>